{
  "_comment": "Giovanni hook trigger map. Every command is anchored on ${CLAUDE_PLUGIN_ROOT}: hooks run in the session's current working directory, and a relative path resolves wherever the session last cd'd — the script then does not exist, exits 127, and the gate goes quiet without a word. The project the hooks act on is $CLAUDE_PROJECT_DIR (exported to every hook process), never the cwd. The permission half of the external write gate (permissions.ask/deny, autoMemoryEnabled) cannot ship in a plugin — /giovanni:init writes it into the project's .claude/settings.json. Two layers on purpose; neither is load-bearing alone (docs/governance.md § External write gate).",

  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-start-digest.sh",
            "timeout": 10,
            "statusMessage": "Giovanni: checking digest freshness..."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-start-audit-check.sh",
            "timeout": 10,
            "statusMessage": "Giovanni: checking memory-audit cadence..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/check-decision-records.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/block-external-writes.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/post-constitution-edit-check.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/post-knowledge-edit.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/post-memory-edit.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/check-unmerged-claude-branches.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/stop-ephemeral-commit-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
