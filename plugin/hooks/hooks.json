{
  "description": "Giovanni hook trigger map. Every command is exec form (command + args), anchored on ${CLAUDE_PLUGIN_ROOT}: hooks run in the session's current working directory, and a relative path resolves wherever the session last cd'd — the script then does not exist, exits 127, and the gate goes quiet without a word. The project the hooks act on is $CLAUDE_PROJECT_DIR (exported to every hook process), never the cwd. The permission half of the external write gate (permissions.ask/deny, autoMemoryEnabled) cannot ship in a plugin — /giovanni:init writes it into the project's .claude/settings.json. Two layers on purpose; neither is load-bearing alone (docs/governance.md § External write gate). The autonomy layer (inbox, confirm paths, autocommit, learning loop) is opt-in per project through docs/governance.config.yaml and is a no-op until configured (docs/autonomy.md).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start-digest.sh",
            "args": [],
            "timeout": 10,
            "statusMessage": "Giovanni: checking digest freshness..."
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start-audit-check.sh",
            "args": [],
            "timeout": 10,
            "statusMessage": "Giovanni: checking memory-audit cadence..."
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start-inbox.sh",
            "args": [],
            "timeout": 60,
            "statusMessage": "Giovanni: refreshing the inbox..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/check-decision-records.sh",
            "args": [],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/block-external-writes.sh",
            "args": [],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-edit-confirm.sh",
            "args": [],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post-constitution-edit-check.sh",
            "args": [],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post-knowledge-edit.sh",
            "args": [],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post-memory-edit.sh",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/check-unmerged-claude-branches.sh",
            "args": [],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop-ephemeral-commit-guard.sh",
            "args": [],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop-session-record.sh",
            "args": [],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop-autocommit.sh",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/prompt-correction.sh",
            "args": [],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
